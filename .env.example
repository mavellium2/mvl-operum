# ─────────────────────────────────────────────────────────────────────────────
# MVL Operum — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker Compose ────────────────────────────────────────────────────────────
# Unique name for this environment — scopes all Docker resources (networks, volumes)
# Use: mvloperum-staging  OR  mvloperum-prod
COMPOSE_PROJECT_NAME=mvloperum-staging

# Tag of the Docker image to deploy (set by CI/CD to the git SHA)
IMAGE_TAG=latest

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=staging

# Public-facing URL (used client-side and for SSR absolute URL construction)
NEXT_PUBLIC_API_URL=https://staging.operum.adm.br

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_USER=mvluser
DB_PASSWORD=change-me-staging
DB_NAME=mvloperum_staging
# DATABASE_URL=postgresql://mvluser:change-me-staging@postgres:5432/mvloperum_staging
DATABASE_URL=postgresql://mvluser:M4v3ll1um@127.0.0.1:5436/mvloperum?schema=public

# ── Authentication ────────────────────────────────────────────────────────────
# Legacy HS256 secret — kept for backward compatibility during JWT migration.
# After all existing sessions expire (7 days), this can be removed.
SESSION_SECRET=change-me-at-least-32-characters-long
# Minutos sem uso até a sessão expirar (proxy + aviso no navegador). Padrão: 30.
# NEXT_PUBLIC_*: embutida no build do app — mudar exige novo build da imagem.
NEXT_PUBLIC_SESSION_IDLE_MINUTES=30

# RS256 key pair — used for all new sessions.
# Generate with:
#   openssl genrsa -out private.pem 4096
#   openssl rsa -in private.pem -pubout -out public.pem
# Then inline (replace newlines with \n):
#   JWT_PRIVATE_KEY="$(awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' private.pem)"
#   JWT_PUBLIC_KEY="$(awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' public.pem)"
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

MINIO_ENDPOINT=localhost
MINIO_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mvloperum
MINIO_PUBLIC_URL=http://localhost:9001

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis-session
REDIS_QUEUE_HOST=redis
REDIS_CACHE_HOST=redis-cache
REDIS_PORT=6379
# Required — Redis runs with --requirepass; generate with: openssl rand -hex 32
REDIS_PASSWORD=change-me-redis-password

# ── Microservices ─────────────────────────────────────────────────────────────
# Internal URL used by the Next.js server to reach the API gateway without
# going through the public internet. In Docker Compose this is the service name.
# For local dev (running Next.js directly): http://localhost:4000
API_GATEWAY_INTERNAL_URL=http://api-gateway:4000

# Public-facing URL (client-side and SSR fallback when API_GATEWAY_INTERNAL_URL is unset)
NEXT_PUBLIC_API_URL=https://staging.operum.adm.br

# Direct service URLs (used by authClient.ts and other non-gateway paths)
# For local dev: http://localhost:4001
AUTH_SERVICE_URL=http://auth-service:4001

# Default tenant ID for self-registration (signupAction). Run once to find it:
#   SELECT id FROM "Tenant" WHERE status = 'ACTIVE' LIMIT 1;
DEFAULT_TENANT_ID=

NOTIFICATION_SERVICE_URL=http://notification-service:4004
FILE_SERVICE_URL=http://localhost:4005

# URL pública do mcp-server (Fase 2 do SDD de integração MCP), usada apenas
# para preencher o comando `claude mcp add` no modal de criação de PAT.
# Endereço do MCP no comando de /perfil/tokens. Fixado no build; mcp.operum.adm.br ainda sem DNS.
NEXT_PUBLIC_MCP_SERVER_URL=https://api.operum.adm.br/mcp


# Required — shared secret between services
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=change-me-internal-api-key

# Comma-separated list of allowed CORS origins for api-gateway (e.g.
# https://staging.operum.adm.br,https://operum.adm.br). Consumed by
# api-gateway/src/main.ts and referenced by docker-compose.yml.
ALLOWED_ORIGINS=

# ── Observability (production only) ───────────────────────────────────────────
BASE_DOMAIN=operum.adm.br
GRAFANA_PASSWORD=change-me-grafana

# ── Vercel Blob (legacy — only needed for the one-time migration script) ───────
# After running scripts/migrate-blobs.ts, this can be removed.
BLOB_READ_WRITE_TOKEN=

# API gateway: consulta o catálogo de permissões no app Next.js.
# Docker Compose define http://app:3000; desenvolvimento local usa localhost.
AUTHORIZATION_SERVICE_URL=http://localhost:3000

# SDD 11: optional outbound webhook compatible with Alertmanager.
# Empty keeps local Prometheus/Alertmanager alerts and warns during deploy.
# Never commit its credential-bearing URL.
ALERT_WEBHOOK_URL=

# MCP: uma réplica para links de uso único (10 minutos).
# Gere a chave com: openssl rand -base64 32
MCP_UPLOAD_SECRET=
# Fallback atual; após configurar o DNS dedicado, pode usar https://mcp.operum.adm.br
MCP_PUBLIC_URL=https://api.operum.adm.br

# MCP OAuth (ChatGPT, Claude e clientes MCP locais). SDD-mcp-oauth / ADR-067.
# Sem OAUTH_ISSUER, MCP_RESOURCE_URL e MCP_GATEWAY_KEY o MCP aceita só PAT, como antes.
# Os mesmos valores valem para auth-service, api-gateway e mcp-server.
# Staging: https://api-staging.operum.adm.br, https://mcp-staging.operum.adm.br/mcp
# e https://staging.operum.adm.br/oauth/autorizar.
OAUTH_ISSUER=
MCP_RESOURCE_URL=
OAUTH_AUTHORIZE_URL=
# Segredo só do mcp-server e do api-gateway: o gateway aceita token OAuth apenas com ele.
# Gere com: openssl rand -base64 32
MCP_GATEWAY_KEY=
# Hosts exatos de client_id CIMD; mantenha os dois ao atualizar ambientes existentes.
OAUTH_CIMD_ALLOWED_HOSTS=claude.ai,chatgpt.com
# Redirects EXATOS aceitos no DCR, além do loopback dos clientes locais.
# Se o ChatGPT mostrar retorno específico da conexão, acrescente a URL exata, sem curingas.
OAUTH_DCR_ALLOWED_REDIRECTS=https://claude.ai/api/mcp/auth_callback,https://chatgpt.com/connector_platform_oauth_redirect

# auth-service: e-mail do "Esqueci minha senha" (código de 8 caracteres, 15 min).
# Sem SMTP_HOST/PORT/USER/PASSWORD o código NÃO é enviado: em produção o serviço registra
# erro na subida e a cada pedido, e o deploy avisa. 465 = SSL; 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Operum" <no-reply@mavellium.com.br>
# Link que aparece no e-mail.
APP_PUBLIC_URL=https://operum.adm.br
