generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ── Multi-Tenant ──────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  REMOVED
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  subdomain String       @unique
  status    TenantStatus @default(ACTIVE)
  config    Json?
  deletedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users                   User[]
  tags                    Tag[]
  projects                Project[]
  departments             Department[]
  roles                   Role[]
  auditLogs               AuditLog[]
  stakeholders            Stakeholder[]
  projectDrafts           ProjectDraft[]
  wbsNodes                WbsNode[]
  eapTemplates            EapTemplate[]
  eapDocuments            EapDocument[]
  documentRevisionsDrafts DocumentDraft[]
}

// ── Projects ──────────────────────────────────────────────

enum ProjectStatus {
  ACTIVE
  INACTIVE
  COMPLETED
  ARCHIVED
}

model Project {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  name        String
  description String?

  logoUrl   String?
  slogan    String?
  location  String?
  startDate DateTime?
  endDate   DateTime?

  justificativa     String? @db.Text
  objetivos         String? @db.Text
  metodologia       String? @db.Text
  descricaoProduto  String? @db.Text
  premissas         String? @db.Text
  restricoes        String? @db.Text
  limitesAutoridade String? @db.Text

  semestre      String?
  ano           Int?
  departamentos String[]

  /// Planilha de Custos: salário mínimo de referência e jornada diária (federação tempo→custo)
  valorReferencia Float?
  horasPorDia     Float?

  /// Durable desired macrofase batch and last EAP revision applied by the app.
  macroFasesRevision       Int @default(0)
  macroFasesSyncedRevision Int @default(0)
  macroFasesSyncError      String?

  status    ProjectStatus @default(ACTIVE)
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  sprints            Sprint[]
  cards              Card[]
  members            UserProject[]
  usuariosRole       UserProjectRole[]
  permissoesUsuarios UserPermission[]
  macroFases         ProjectMacroFase[]

  stakeholders            ProjectStakeholder[]
  documentRevisionsDrafts DocumentDraft[]
  documentVersions        DocumentVersion[]
  drafts                  ProjectDraft[]
  wbsNodes                WbsNode[]

  projetoDepartamentos ProjetoDepartamento[]
  projetoFuncoes       ProjetoFuncao[]
  atas                 Ata[]
  eapDocument          EapDocument?

  @@unique([name, tenantId])
}

model ProjectMacroFase {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position   Int @default(0)
  fase       String
  dataLimite String?
  custo      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ProjectDraft {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  data      Json
  savedAt   DateTime @default(now()) @updatedAt
}

// ── Departments ───────────────────────────────────────────

model Department {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  active      Boolean   @default(true)
  hourlyRate  Float?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users                UserDepartment[]
  userProjects         UserProject[]
  projetoDepartamentos ProjetoDepartamento[]

  @@unique([name, tenantId])
}

model UserDepartment {
  id           String     @id @default(cuid())
  userId       String
  departmentId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
}

model UserProject {
  id           String      @id @default(cuid())
  userId       String
  projectId    String
  active       Boolean     @default(true)
  inactiveReason String?   @db.Text // Motivo da inativação do membro no projeto (com active = false)
  inactivatedAt  DateTime? // Quando foi inativado
  role         String?
  departmentId String?
  hourlyRate   Float?
  remuneracao  Float?
  horasDiarias Float?
  startDate    DateTime    @default(now())
  endDate      DateTime?
  order        Int         @default(0)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([userId, projectId])
}

// Associação de um departamento do catálogo global do tenant a um projeto
model ProjetoDepartamento {
  id             String   @id @default(cuid())
  projetoId      String
  departamentoId String
  createdAt      DateTime @default(now())

  project    Project    @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departamentoId], references: [id], onDelete: Cascade)

  @@unique([projetoId, departamentoId])
  @@index([departamentoId])
}

// Associação de uma função (Role globais do tenant) a um projeto
model ProjetoFuncao {
  id        String   @id @default(cuid())
  projetoId String
  funcaoId  String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [funcaoId], references: [id], onDelete: Cascade)

  @@unique([projetoId, funcaoId])
  @@index([funcaoId])
}

// ── RBAC ───────────────────────────────────────────────────

enum RoleScope {
  TENANT
  PROJETO
}

model Role {
  id                    String    @id @default(cuid())
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  name                  String    @map("nome")
  nameKey               String    @map("nomeKey")
  scope                 RoleScope @map("escopo")
  description           String?   @map("descricao")
  /// Quando o admin salvou a matriz desta função. Nulo = usa o padrão (lib/permissoes.ts).
  permissoesDefinidasEm DateTime?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  permissions      RolePermission[]
  userProjectRoles UserProjectRole[]
  projetoFuncoes   ProjetoFuncao[]

  @@unique([nameKey, tenantId, scope])
}

model Permission {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  resource    String
  action      String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  roles    RolePermission[]
  usuarios UserPermission[]

  @@unique([resource, action])
}

enum PermissionEffect {
  GRANT
  DENY
}

/// Ajuste de permissão por usuário (SDD 5.1): concede ou nega a mais ou a menos
/// do que as funções dão. Sem projectId vale para todos os projetos; com
/// projectId, só naquele projeto (e vence o ajuste global).
/// Índice único parcial (userId, permissionId) WHERE projectId IS NULL criado na
/// migration: o Postgres não trata NULL como igual no @@unique abaixo.
model UserPermission {
  id           String           @id @default(cuid())
  userId       String
  projectId    String?
  permissionId String
  effect       PermissionEffect
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, permissionId])
  @@index([userId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserProjectRole {
  id        String    @id @default(cuid())
  userId    String
  projectId String    @map("projetoId")
  roleId    String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  createdAt DateTime  @default(now()) @map("criadoEm")
  updatedAt DateTime  @updatedAt

  @@unique([userId, projectId])
}

// ── Users ─────────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  name                String
  email               String
  passwordHash        String
  role                String    @default("member")
  avatarUrl           String?
  signatureUrl        String?
  cargo               String?
  departamento        String?
  hourlyRate          Float     @default(0)
  isActive            Boolean   @default(true)
  status              String    @default("active")
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?
  loginAttempts       Int       @default(0)
  forcePasswordChange Boolean   @default(false)
  lastLogin           DateTime?
  tokenVersion        Int       @default(0)
  resetToken          String?
  resetTokenExpiry    DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  phone               String?
  cep                 String?
  logradouro          String?
  numero              String?
  complemento         String?
  bairro              String?
  cidade              String?
  estado              String?
  notes               String?   @db.Text

  tags             Tag[]
  sprints          Sprint[]
  timeEntries      TimeEntry[]
  responsibleCards CardResponsible[]
  departments      UserDepartment[]
  projects         UserProject[]
  permissoes       UserPermission[]
  comments         Comment[]
  notifications    Notification[]
  dashboardMetrics DashboardMetric[]
  sprintFeedbacks  SprintFeedback[]

  documentRevisionsDrafts  DocumentDraft[]
  documentVersionsAuthored DocumentVersion[] @relation("DocumentVersionAuthor")
  documentVersionsApproved DocumentVersion[] @relation("DocumentVersionApprover")

  atasPresentes         AtaPresente[]
  atasAcoesResponsaveis AtaAcao[]     @relation("AtaAcaoResponsavel")
  atasElaboradas        Ata[]         @relation("AtaElaboradoPor")
  atasAprovadas         Ata[]         @relation("AtaAprovadoPor")

  @@unique([email, tenantId])
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model Sprint {
  id               String            @id @default(cuid())
  name             String
  description      String?
  status           SprintStatus      @default(PLANNED)
  startDate        DateTime?
  endDate          DateTime?
  qualidade        Float?
  dificuldade      Float?
  projectId        String?
  project          Project?          @relation(fields: [projectId], references: [id])
  createdBy        String?
  creator          User?             @relation(fields: [createdBy], references: [id])
  cards            Card[]
  sprintColumns    SprintColumn[]
  dashboardMetrics DashboardMetric[]
  sprintFeedbacks  SprintFeedback[]
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model SprintColumn {
  id        String    @id @default(cuid())
  title     String
  position  Int
  color     String?
  sprintId  String
  sprint    Sprint    @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  cards     Card[]    @relation("SprintColumnCards")
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Tag {
  id       String    @id @default(cuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  name     String
  color    String    @default("#6b7280")
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards    CardTag[]

  @@unique([name, userId])
}

model CardTag {
  cardId String
  tagId  String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
}

model CardResponsible {
  cardId String
  userId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
}

model Card {
  id             String        @id @default(cuid())
  title          String
  description    String        @default("")
  color          String        @default("#6b7280")
  position       Int           @default(0)
  sprintId       String?
  sprint         Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  sprintColumnId String?
  sprintColumn   SprintColumn? @relation("SprintColumnCards", fields: [sprintColumnId], references: [id], onDelete: SetNull)
  sprintPosition Int?
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  priority       String        @default("media")
  tagsImport     String        @default("")
  startDate      DateTime?
  endDate        DateTime?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tags         CardTag[]
  attachments  Attachment[]
  timeEntries  TimeEntry[]
  responsibles CardResponsible[]
  comments     Comment[]
  movements    CardMovement[]
}

model CardMovement {
  id              String   @id @default(cuid())
  cardId          String
  card            Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId          String?
  fromColumnId    String?
  fromColumnTitle String?
  toColumnId      String?
  toColumnTitle   String?
  reason          String?
  movedAt         DateTime @default(now())
}

// ── Comment ───────────────────────────────────────────────

enum CommentType {
  COMMENT
  FEEDBACK
}

model Comment {
  id        String      @id @default(cuid())
  cardId    String
  card      Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  type      CommentType @default(COMMENT)
  reactions Json?
  deletedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// ── Notification ──────────────────────────────────────────

enum NotificationType {
  COMMENT
  ASSIGNMENT
  UPDATE
  COMPLETION
  MENTIONED
  INVITATION
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

model Notification {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  message       String
  reference     String?
  referenceType String?
  status        NotificationStatus @default(UNREAD)
  deletedAt     DateTime?
  createdAt     DateTime           @default(now())
  readAt        DateTime?
  updatedAt     DateTime           @updatedAt
}

model Attachment {
  id         String    @id @default(cuid())
  cardId     String
  card       Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  fileName   String
  fileType   String
  filePath   String
  fileSize   Int
  isCover    Boolean   @default(false)
  deletedAt  DateTime?
  uploadedAt DateTime  @default(now())
}

// Partial uniqueness for active timers lives in migration 20261004010000_unique_running_timer.
// userId is unique only when isRunning=true and deletedAt IS NULL (manual/stopped entries remain unrestricted).
model TimeEntry {
  id          String    @id @default(cuid())
  userId      String
  cardId      String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  duration    Int       @default(0)
  description String?
  isRunning   Boolean   @default(false)
  isManual    Boolean   @default(false)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card        Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ── AuditLog ──────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  timestamp DateTime @default(now())
}

// ── DashboardMetric ───────────────────────────────────────

model DashboardMetric {
  id               String   @id @default(cuid())
  sprintId         String
  sprint           Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  horas            Float    @default(0)
  tarefasPendentes Int      @default(0)
  custoTotal       Float    @default(0)
  rankingPosicao   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([sprintId, userId])
}

// ── SprintFeedback ────────────────────────────────────────

model SprintFeedback {
  id                String   @id @default(cuid())
  sprintId          String
  sprint            Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tarefasRealizadas String?
  dificuldades      String?
  qualidade         Int
  dificuldade       Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([sprintId, userId])
}

model Stakeholder {
  id          String   @id @default(cuid())
  tenantId    String
  name        String // Nome
  logoUrl     String? // Logo do Stakeholder
  company     String? // Empresa
  competence  String? // Competência
  email       String? // e-mail
  phone       String? // Telefone/Fax
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  notes       String?  @db.Text // Observações
  isActive    Boolean  @default(true)
  inactiveReason String?  @db.Text // Motivo da inativação (obrigatório ao desativar)
  inactivatedAt  DateTime? // Quando foi inativado
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects ProjectStakeholder[]

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// Tabela de Vínculo (Projeto <-> Stakeholder)
model ProjectStakeholder {
  id            String   @id @default(cuid())
  projectId     String
  stakeholderId String
  createdAt     DateTime @default(now())

  order       Int         @default(0)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  @@unique([projectId, stakeholderId])
}

enum DocumentVersionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  STAKEHOLDER
  CHARTER
  EAP
  ATA
}

model DocumentVersion {
  changes           Json?
  previousVersionId String?
  sequence      Int                   @unique @default(autoincrement())
  payload       Json?
  resourceId    String                @default("")
  id            String                @id @default(cuid())
  projectId     String
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commitTitle   String                @default("")
  versao        String
  elaboradoPor  String
  aprovadoPor   String
  dataAprovacao String
  authorId      String?
  author        User?                 @relation("DocumentVersionAuthor", fields: [authorId], references: [id])
  status        DocumentVersionStatus @default(PENDING)
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    User?                 @relation("DocumentVersionApprover", fields: [approvedById], references: [id])
  documentType  DocumentType          @default(STAKEHOLDER)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([projectId, documentType, resourceId, status, approvedAt], map: "DocumentVersion_current_idx")
}

// ── Atas de Reunião ───────────────────────────────────────

model Ata {
  instituicao        String?
  id                 String    @id @default(cuid())
  tenantId           String
  projetoId          String
  numero             Int
  nomeProjeto        String
  local              String?
  data               DateTime
  elaboradoPor       String
  elaboradoPorUserId String?
  elaboradoPorUser   User?     @relation("AtaElaboradoPor", fields: [elaboradoPorUserId], references: [id], onDelete: SetNull)
  aprovadoPor        String?
  aprovadoPorUserId  String?
  aprovadoPorUser    User?     @relation("AtaAprovadoPor", fields: [aprovadoPorUserId], references: [id], onDelete: SetNull)
  assuntosTratados   String?   @db.Text
  decisoesTomadas    String?   @db.Text
  observacoes        String?   @db.Text
  copiasPara         String[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  project   Project       @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  presentes AtaPresente[]
  acoes     AtaAcao[]
  anexos    AtaAnexo[]

  @@unique([projetoId, numero])
  @@index([tenantId])
  @@index([projetoId])
}

model AtaPresente {
  id           String  @id @default(cuid())
  ataId        String
  nome         String
  setorEmpresa String?
  userId       String?
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  ata          Ata     @relation(fields: [ataId], references: [id], onDelete: Cascade)
}

model AtaAcao {
  id                String    @id @default(cuid())
  ataId             String
  acao              String    @db.Text
  prazo             DateTime?
  responsavel       String?
  responsavelUserId String?
  responsavelUser   User?     @relation("AtaAcaoResponsavel", fields: [responsavelUserId], references: [id], onDelete: SetNull)
  ata               Ata       @relation(fields: [ataId], references: [id], onDelete: Cascade)
}

model AtaAnexo {
  id    String  @id @default(cuid())
  ataId String
  nome  String
  url   String?
  ata   Ata     @relation(fields: [ataId], references: [id], onDelete: Cascade)
}

// ── WBS / EAP ─────────────────────────────────────────────

/// Na raiz: formato da EAP inteira. Numa fase (1º nível): ESQUERDA/DIREITA = formato próprio
/// da fase; outro valor = segue a EAP. Abaixo das fases não é usado (ADR-047, lib/wbsLayout.ts).
enum WbsLayoutOrientation {
  LADO_A_LADO // Padrão: lado a lado; itens com filhos só folhas empilham com a linha à esquerda
  DIREITA // fases lado a lado; abaixo delas, filhos empilhados à direita da linha do centro
  ESQUERDA // espelho de DIREITA: filhos empilhados à esquerda
  HORIZONTAL // raiz em pé à esquerda; cada nível numa coluna à direita do anterior
}

model WbsNode {
  id        String  @id @default(cuid())
  tenantId  String
  projectId String
  parentId  String?

  /// posição 0-based entre irmãos — FONTE DE VERDADE da ordenação
  order Int
  /// DERIVADO ("1.2.1"); recalculado pelo servidor — sem @@unique para permitir renumeração transacional
  code  String @db.VarChar(255)
  title String @db.VarChar(500)

  layout    WbsLayoutOrientation @default(LADO_A_LADO)
  collapsed Boolean              @default(false)

  /// WbsNodeStyle
  style      Json
  /// WbsNodeProperties
  properties Json

  /// optimistic concurrency da árvore
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   WbsNode?  @relation("WbsHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children WbsNode[] @relation("WbsHierarchy")

  @@unique([parentId, order])
  @@index([tenantId])
  @@index([projectId])
  @@index([parentId])
}

// ── EAP — Template documental (Estrutura Analítica do Projeto) ──────────────

/// Matriz protegida: define a estrutura/layout do documento-modelo.
/// Não é editada pelos usuários — apenas usada para criar documentos.
model EapTemplate {
  id          String  @id @default(cuid())
  name        String
  version     String  @default("1.0")
  description String?
  isActive    Boolean @default(true)

  /// EapNode[] — estrutura inicial (placeholders) usada ao criar documentos.
  structure Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  documents EapDocument[]

  @@index([tenantId])
}

/// Documento EAP — instância independente criada a partir do template
/// (SPEC §15: alterar um documento nunca altera o template).
model EapDocument {
  id         String @id @default(cuid())
  tenantId   String
  projectId  String @unique
  templateId String

  projectName    String  @default("")
  projectManager String  @default("")
  preparedBy     String  @default("")
  version        String  @default("1.0")
  approvedBy     String  @default("")
  signature      String  @default("")
  /// aaaa-mm-dd (string para evitar viés de fuso, padrão do app)
  approvalDate   String?

  /// EapNode[] — árvore da EAP (códigos normalizados pelo servidor)
  nodes     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template EapTemplate @relation(fields: [templateId], references: [id])

  @@index([tenantId])
}

// Rascunho privado por autor. Versões submetidas são snapshots imutáveis.
model DocumentDraft {
  id           String       @id @default(cuid())
  projectId    String
  tenantId     String
  userId       String
  documentType DocumentType
  resourceId   String       @default("")
  payload      Json
  updatedAt    DateTime     @updatedAt
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, documentType, resourceId])
  @@index([tenantId, projectId])
}
