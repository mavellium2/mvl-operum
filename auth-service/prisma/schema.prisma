generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}


enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  REMOVED
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  subdomain String       @unique
  status    TenantStatus @default(ACTIVE)
  config    Json?
  deletedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users     User[]
  apiTokens ApiToken[]
  oauthGrantTenants OAuthGrantTenant[]
}

model User {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  name                String
  email               String
  passwordHash        String
  role                String    @default("member")
  avatarUrl           String?
  signatureUrl        String?
  cargo               String?
  departamento        String?
  hourlyRate          Float     @default(0)
  phone               String?
  cep                 String?
  logradouro          String?
  numero              String?
  complemento         String?
  bairro              String?
  cidade              String?
  estado              String?
  notes               String?
  isActive            Boolean   @default(true)
  status              String    @default("active")
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?
  loginAttempts       Int       @default(0)
  forcePasswordChange Boolean   @default(false)
  lastLogin           DateTime?
  tokenVersion        Int       @default(0)
  resetToken          String?
  resetTokenExpiry    DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  apiTokens ApiToken[]
  oauthGrantTenants OAuthGrantTenant[]

  @@unique([email, tenantId])
}

model ApiToken {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  name       String
  prefix     String
  tokenHash  String    @unique
  scopes     String[]
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, tenantId])
}

// ── OAuth 2.1 para conectores MCP (SDD-mcp-oauth, ADR-056) ────────────────────
// Códigos e tokens são guardados só como hash SHA-256.

model OAuthClient {
  id           String    @id @default(cuid())
  clientId     String    @unique // URL (CIMD) ou id gerado (DCR)
  kind         String // "cimd" | "dcr"
  name         String
  redirectUris String[]
  fetchedAt    DateTime? // CIMD: última leitura do documento
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  grants OAuthGrant[]
}

model OAuthGrant {
  id          String    @id @default(cuid())
  clientRowId String
  email       String
  resource    String
  scopes      String[]
  redirectUri String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime // teto absoluto da conexão
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  client  OAuthClient        @relation(fields: [clientRowId], references: [id])
  tenants OAuthGrantTenant[]
  tokens  OAuthToken[]

  @@index([email])
}

model OAuthGrantTenant {
  grantId   String
  tenantId  String
  userId    String
  isDefault Boolean @default(false)

  grant  OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  tenant Tenant     @relation(fields: [tenantId], references: [id])
  user   User       @relation(fields: [userId], references: [id])

  @@id([grantId, tenantId])
  @@index([userId])
}

model OAuthCode {
  codeHash      String    @id
  clientRowId   String
  redirectUri   String
  codeChallenge String
  resource      String
  scopes        String[]
  email         String
  tenants       Json // [{ tenantId, userId, isDefault }]
  expiresAt     DateTime
  usedAt        DateTime?
  grantId       String? // preenchido na troca; reuso do código revoga este grant
  createdAt     DateTime  @default(now())
}

model OAuthToken {
  tokenHash String    @id
  grantId   String
  type      String // "access" | "refresh"
  expiresAt DateTime
  rotatedAt DateTime? // refresh já trocado por um novo par
  createdAt DateTime  @default(now())

  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
}
